# =============================================================================
# AI & Blockchain Project - Environment Configuration Example
# =============================================================================
# Copy this file to .env and update values as needed for your setup

# -----------------------------------------------------------------------------
# Blockchain Configuration
# -----------------------------------------------------------------------------
BLOCKCHAIN_NETWORK_URL="http://127.0.0.1:8545"
BLOCKCHAIN_CHAIN_ID="31337"
BLOCKCHAIN_NETWORK_NAME="localhost"

# -----------------------------------------------------------------------------
# Private Keys (Hardhat default accounts for local development)
# -----------------------------------------------------------------------------
# Private key for Worker 0 (Hardhat Account #1)
WORKER_PRIVATE_KEY_0="0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d"

# Private key for Worker 1 (Hardhat Account #2)
WORKER_PRIVATE_KEY_1="0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a"

# Private key for MTX submissions in E2E tests (Hardhat Account #0)
TEST_WORKER_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# Private key for ModelRegistry owner/operator (Hardhat Account #0)
REGISTRY_OPERATOR_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# -----------------------------------------------------------------------------
# IPFS Configuration
# -----------------------------------------------------------------------------
IPFS_API_URL="http://127.0.0.1:5001"

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL="INFO"
LOG_FILE_LEVEL="DEBUG"
LOG_DIR="logs"
LOG_FILE="aibc.log"
LOG_JSON="0"

# -----------------------------------------------------------------------------
# Environment Profile
# -----------------------------------------------------------------------------
# "dev" = full dataset/model, "test" = tiny dataset for fast iteration
DPODL_ENV="test"

# -----------------------------------------------------------------------------
# Ray Configuration (optional)
# -----------------------------------------------------------------------------
# Leave empty for local Ray cluster, set to ray://host:port for remote cluster
RAY_ADDRESS=""

# -----------------------------------------------------------------------------
# Production/Testnet Configuration (uncomment and set for non-local use)
# -----------------------------------------------------------------------------
# SEPOLIA_RPC_URL="YOUR_SEPOLIA_RPC_URL"
# DEPLOYER_PRIVATE_KEY="YOUR_DEPLOYER_PK_FOR_SEPOLIA"
# ETHERSCAN_API_KEY="YOUR_ETHERSCAN_KEY"

# PINATA_API_KEY="your_pinata_api_key"
# PINATA_API_SECRET="your_pinata_api_secret"
# PINATA_JWT="your_pinata_jwt_token"
# ENABLE_PINATA_PINNING="false"
